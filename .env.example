
# ==========================================
# FLOWCHAT — Variáveis de ambiente
# ==========================================

# PostgreSQL / Neon
# URL de conexão utilizada pela aplicação
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=verify-full"

# Conexão direta para migrations, caso utilizada
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=verify-full"

# Google Gemini
# Obtenha em: https://aistudio.google.com/apikey
GEMINI_API_KEY=""

# Auth.js
# Gere um segredo com: pnpm exec auth secret
AUTH_SECRET=""

# GitHub OAuth
# Configure em: https://github.com/settings/developers
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# Upstash Redis
# Obtenha no painel da sua instância Redis
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
